# Copiar este archivo como  .env  y pegar la clave real ALLA, no aca.
#
#   Windows:  copy .env.ejemplo .env
#   Mac:      cp .env.ejemplo .env
#
# Este archivo (.env.ejemplo) SI se sube al repositorio: nunca pongas una
# clave real adentro. El que queda afuera del repo es .env
#
# Claves segun el proveedor que uses en config.yaml -> traduccion.proveedor:
#   claude  -> https://console.anthropic.com  (API Keys)
#   gemini  -> https://aistudio.google.com/apikey

ANTHROPIC_API_KEY=sk-ant-aca-va-tu-clave
GEMINI_API_KEY=aca-va-tu-clave-de-gemini

# Opcional. Protege los controles del panel (pausar, cambiar audio, guardar):
# sin esto, cualquiera en la red de la iglesia podria cambiarlos con un POST,
# sin login. Ver los subtitulos o el panel en si NO pide PIN, solo lo que
# cambia algo.
#
# Sin definir -> se genera uno al azar por sesion y se muestra en la terminal
#                al arrancar. Hay que escribirlo en el panel una vez por
#                dispositivo (celular, laptop); despues lo recuerda solo.
# Un numero    -> ese PIN fijo, para no tener que reingresarlo en cada reinicio.
# "ninguno"    -> desactiva la proteccion (una red que ya se considera de confianza).
#
# PANEL_PIN=482913
