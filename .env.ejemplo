# Copiar este archivo como  .env  y pegar la clave real ALLA, no aca.
#
#   Windows:  copy .env.ejemplo .env
#   Mac:      cp .env.ejemplo .env
#
# Este archivo (.env.ejemplo) SI se sube al repositorio: nunca pongas una
# clave real adentro. El que queda afuera del repo es .env
#
# Claves segun el proveedor que uses en config.yaml -> traduccion.proveedor:
#   claude  -> https://console.anthropic.com  (API Keys)
#   gemini  -> https://aistudio.google.com/apikey

ANTHROPIC_API_KEY=sk-ant-aca-va-tu-clave
GEMINI_API_KEY=aca-va-tu-clave-de-gemini
